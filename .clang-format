# CLAUDE.md tech constraints: clang-format, Google style, enforced in CI.
---
Language: Cpp
BasedOnStyle: Google
Standard: c++20
ColumnLimit: 100
DerivePointerAlignment: false
PointerAlignment: Left
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<lob/'
    Priority: 3
  - Regex: '^<gtest/|^<gmock/|^<benchmark/'
    Priority: 4
  - Regex: '^<.*\.h>'
    Priority: 1
  - Regex: '^<.*>'
    Priority: 2
  - Regex: '.*'
    Priority: 5
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false

# Normalise text line endings so the determinism/golden tests compare equal
# across Windows and the Linux CI runners.
* text=auto eol=lf

*.sln    text eol=crlf
*.vcxproj text eol=crlf
*.bat    text eol=crlf
*.ps1    text eol=crlf

# Golden fixtures are byte-compared by tests -- never touch them.
tests/fixtures/**/*.lobbin binary
tests/fixtures/**/*.csv    -text
